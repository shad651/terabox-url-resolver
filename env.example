# =====================================================================
# Terabox Streaming Resolver — Environment Configuration
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# =====================================================================

# ---- REQUIRED -------------------------------------------------------
# Your Terabox `ndus` cookie token (for authentication).
#
# How to get it:
#   1. Log in to https://www.terabox.com (or 1024terabox.com)
#   2. Open Developer Tools (F12) → Application → Cookies → Terabox domain
#   3. Find the cookie named `ndus` and copy its Value
#   4. Paste below
#
# You may also pass a full JSON cookie object if you have one:
#   COOKIE_JSON={"ndus": "...", "BDCLND": "..."}
COOKIE_JSON=

# ---- OPTIONAL ------------------------------------------------------
# Cloudflare Worker / reverse proxy URL.
# If set, all upstream Terabox API calls are routed through:
#   <PROXY_URL>?url=<terabox_api_url>
# Leave empty for direct mode (calls Terabox from your own IP).
PROXY_URL=

# ---- SERVER --------------------------------------------------------
# Port and bind address.
PORT=5000
HOST=0.0.0.0

# Set to 1 to enable Flask debug mode (auto-reload on file changes).
DEBUG=0

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
